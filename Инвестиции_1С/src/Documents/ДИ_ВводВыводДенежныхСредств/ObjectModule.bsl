Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ДИ_ДенежныеСредстваПортфелей.Записывать = Истина;
	
	Если ВидОперации = Перечисления.ДИ_ВидОперацииДС.Ввод Тогда
		ВидДвижения = ВидДвиженияНакопления.Приход;
	Иначе
		ВидДвижения = ВидДвиженияНакопления.Расход;
	КонецЕсли;
	
	Запись = Движения.ДИ_ДенежныеСредстваПортфелей.Добавить();
	Запись.ВидДвижения = ВидДвижения;
	Запись.Период = ДатаОперации;
	Запись.Портфель = Портфель;
	Запись.Валюта = Валюта;
	Запись.Сумма = Сумма;
	
	ОписаниеРегистровДляКОнтроля = новый Массив;
	ОписаниеРегистровДляКОнтроля.Добавить(новый Структура("ИмяРегистра", "ДИ_ДенежныеСредстваПортфелей"));
	
	ДИ_ОбщегоНазначения.ЗаписатьДвиженияСКонтролемОстатков(ОписаниеРегистровДляКОнтроля, Движения, Отказ);
	
КонецПроцедуры


